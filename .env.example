# Port du serveur web (défaut: 5000)
PORT=5000

# Clé secrète pour les sessions et messages flash Flask
SECRET_KEY=change-me-in-production-super-secret-key

# Clé RapidAPI (optionnel : nécessaire uniquement pour automatisation via privatix-temp-mail)
# Si non renseignée, le générateur utilise le mode QR haute-définition direct autonome
RAPIDAPI_KEY=

# Activer Selenium headless (optionnel : false par défaut)
ENABLE_SELENIUM=false

# Chemin personnalisé vers la base SQLite (défaut: passes.db)
DATABASE_PATH=passes.db
